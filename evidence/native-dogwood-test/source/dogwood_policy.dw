// Permit only authorized, policy-compliant, unambiguous current requests matching user intent.
// Point-policy slice: trusted public facts; default deny; no temporal rule in this fixture.
@id("safe_cancel")
permit (principal, action == TH::Action::"cancel", resource)
when { context.system.authorized && context.system.policy_allows && !context.system.approval_required && context.system.referent_known && context.system.state_current && context.system.intent_match };
